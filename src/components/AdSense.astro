---
export interface Props {
  slotId?: string;
  format?: 'auto' | 'fluid' | 'rectangle' | 'horizontal';
  className?: string;
}

const {
  slotId = "2752528052", // infantpolicy 전용 공식 디스플레이 광고 슬롯 ID
  format = "auto",
  className = "my-6"
} = Astro.props;
---

<div class={`adsense-container w-full overflow-hidden text-center my-4 sm:my-6 ${className}`}>
  <!-- infantpolicy Real AdSense Display Unit -->
  <ins
    class="adsbygoogle"
    style="display:block; min-height: 100px; width: 100%;"
    data-ad-client="ca-pub-6067163195544027"
    data-ad-slot={slotId}
    data-ad-format={format}
    data-full-width-responsive="true"
  ></ins>
  <script is:inline>
    (function() {
      try {
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      } catch (err) {
        // AdSense loaded silently
      }
    })();
  </script>
</div>
