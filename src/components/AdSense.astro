---
export interface Props {
  slotId?: string;
  format?: 'auto' | 'fluid' | 'rectangle' | 'horizontal';
  className?: string;
}

const {
  slotId = "2752528052", // infantpolicy 전용 공식 디스플레이 광고 슬롯 ID
  format = "auto",
  className = "my-6"
} = Astro.props;
---

<div class={`adsense-container w-full overflow-hidden text-center ${className}`}>
  <!-- infantpolicy Real AdSense Display Unit -->
  <ins
    class="adsbygoogle"
    style="display:block"
    data-ad-client="ca-pub-6067163195544027"
    data-ad-slot={slotId}
    data-ad-format={format}
    data-full-width-responsive="true"
  ></ins>
  <script is:inline>
    (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>
