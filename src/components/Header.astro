---
import { categories } from '../data/categories';
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 shadow-sm transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Logo & Brand -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-brand-500 rounded-lg p-1">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-teal-500 to-emerald-400 flex items-center justify-center text-white shadow-md shadow-teal-500/20 group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="text-lg sm:text-xl font-bold tracking-tight text-slate-900 group-hover:text-brand-600 transition-colors">육아정책모음집</span>
            <span class="px-1.5 py-0.5 text-[10px] font-semibold bg-emerald-100 text-emerald-800 rounded-full">2025-2026</span>
          </div>
          <p class="text-[11px] text-slate-500 hidden sm:block">정부 공식 팩트 기반 지원금 & 모의계산기</p>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        <a 
          href="/" 
          class="px-3 py-2 text-sm font-medium text-slate-700 hover:text-brand-600 hover:bg-slate-50 rounded-lg transition-colors"
        >
          홈
        </a>
        <a 
          href="/calculators" 
          class="px-3 py-2 text-sm font-semibold text-brand-700 bg-brand-50/80 hover:bg-brand-100 rounded-lg transition-colors flex items-center gap-1.5"
        >
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-500"></span>
          </span>
          지원금 계산기
        </a>

        <!-- Category Dropdown Menu -->
        <div class="relative group">
          <button 
            type="button" 
            class="px-3 py-2 text-sm font-medium text-slate-700 hover:text-brand-600 hover:bg-slate-50 rounded-lg transition-colors flex items-center gap-1"
            aria-expanded="false"
          >
            정책 카테고리
            <svg class="w-4 h-4 text-slate-400 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          
          <div class="absolute right-0 mt-2 w-64 rounded-2xl bg-white p-2 shadow-xl ring-1 ring-black/5 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top-right">
            <div class="text-[11px] font-semibold text-slate-400 px-3 py-1.5 uppercase tracking-wider">주요 분야 바로가기</div>
            {categories.map((cat) => (
              <a
                href={`/${cat.slug}`}
                class="flex items-center justify-between px-3 py-2 text-sm text-slate-700 hover:bg-teal-50/70 hover:text-brand-700 rounded-xl transition-colors"
              >
                <span>{cat.name}</span>
                <span class="text-xs text-slate-400">➔</span>
              </a>
            ))}
          </div>
        </div>

        <a 
          href="/#search-section" 
          class="p-2 text-slate-500 hover:text-brand-600 hover:bg-slate-100 rounded-lg transition-colors"
          title="정책 검색"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </a>
      </nav>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center gap-2 md:hidden">
        <a 
          href="/calculators"
          class="px-2.5 py-1.5 text-xs font-semibold bg-brand-50 text-brand-700 rounded-lg border border-brand-200"
        >
          계산기
        </a>
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500"
          aria-label="메뉴 열기"
          aria-expanded="false"
        >
          <svg id="hamburger-icon" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-100 bg-white px-4 pt-3 pb-6 space-y-3 shadow-lg">
    <div class="grid grid-cols-2 gap-2">
      <a 
        href="/" 
        class="flex items-center justify-center p-2.5 text-sm font-medium text-slate-800 bg-slate-50 hover:bg-slate-100 rounded-xl"
      >
        🏠 홈 바로가기
      </a>
      <a 
        href="/calculators" 
        class="flex items-center justify-center p-2.5 text-sm font-bold text-teal-800 bg-teal-50 hover:bg-teal-100 rounded-xl"
      >
        🧮 3대 모의계산기
      </a>
    </div>

    <div class="pt-2">
      <div class="text-xs font-bold text-slate-400 px-2 py-1 uppercase tracking-wider">7대 분야별 지원 정책</div>
      <div class="grid grid-cols-1 gap-1 mt-1">
        {categories.map((cat) => (
          <a
            href={`/${cat.slug}`}
            class="flex items-center justify-between px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-brand-600 rounded-xl"
          >
            <span>{cat.name}</span>
            <span class="text-xs text-slate-400 font-mono">바로보기</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.toggle('hidden');
      if (isOpen) {
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
      } else {
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        menuBtn.setAttribute('aria-expanded', 'true');
      }
    });
  }
</script>
