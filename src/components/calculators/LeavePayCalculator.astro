---
---

<div id="leave-calculator" class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-lg shadow-slate-100">
  <div class="flex items-center gap-3 mb-6">
    <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-2xl shadow-inner">
      💼
    </div>
    <div>
      <div class="flex items-center gap-2">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900">
          2026-2027 육아휴직 급여 모의계산기
        </h2>
        <span class="px-2 py-0.5 text-xs font-extrabold bg-blue-100 text-blue-800 rounded-full">개편 상한액 250만 반영</span>
      </div>
      <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
        1~3개월 월 최대 250만원 인상 및 6+6 부모육아휴직제 실수령액을 즉시 계산합니다.
      </p>
    </div>
  </div>

  <!-- Form Inputs -->
  <div class="space-y-4 p-5 bg-slate-50 rounded-2xl border border-slate-100 mb-6">
    <!-- Monthly Salary Input -->
    <div>
      <div class="flex items-center justify-between mb-2">
        <label for="monthly-salary-input" class="text-xs font-bold text-slate-700">
          월 통상임금 (세전 기본급 + 고정수당)
        </label>
        <span id="salary-display-badge" class="text-sm font-extrabold text-blue-700">300만원</span>
      </div>
      <input
        type="range"
        id="salary-slider"
        min="150"
        max="600"
        step="10"
        value="300"
        class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-600"
      />
      <div class="flex justify-between text-[10px] text-slate-400 mt-1">
        <span>150만원 (하한선 70만)</span>
        <span>300만원</span>
        <span>450만원</span>
        <span>600만원</span>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
      <!-- Leave Months -->
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1.5">사용할 육아휴직 기간</label>
        <select id="leave-months-select" class="w-full p-2.5 bg-white border border-slate-200 rounded-xl text-sm font-medium focus:ring-2 focus:ring-blue-500 focus:outline-none">
          <option value="3">3개월 (단기 집중 사용)</option>
          <option value="6">6개월</option>
          <option value="12" selected>12개월 (1년 기본)</option>
          <option value="18">18개월 (부모 모두 3개월 이상 사용 시)</option>
        </select>
      </div>

      <!-- 6+6 Toggle -->
      <div class="flex items-center justify-between p-3 bg-white border border-slate-200 rounded-xl">
        <div>
          <span class="text-xs font-bold text-slate-800">6+6 부모육아휴직제 적용</span>
          <p class="text-[10px] text-slate-500">부모 동시/순차 사용 시 (최대 450만)</p>
        </div>
        <input type="checkbox" id="is-6plus6-check" class="w-5 h-5 accent-blue-600 rounded cursor-pointer" />
      </div>
    </div>
  </div>

  <!-- Results Box -->
  <div class="rounded-2xl bg-gradient-to-br from-blue-600 via-indigo-600 to-blue-800 text-white p-6 sm:p-8 shadow-xl shadow-blue-700/20 mb-6">
    <div class="text-xs sm:text-sm font-medium text-blue-100 flex items-center justify-between">
      <span>총 예상 육아휴직 급여 수령액</span>
      <span class="bg-white/20 px-2 py-0.5 rounded-full text-[11px] backdrop-blur-sm">사후지급금 폐지 (100% 매월 수령)</span>
    </div>
    
    <div class="my-4 flex items-baseline gap-2">
      <span id="total-leave-pay" class="text-4xl sm:text-5xl font-black tracking-tight text-amber-300">
        2,310만원
      </span>
      <span class="text-sm font-medium text-blue-100">전액 지원</span>
    </div>

    <!-- Monthly average -->
    <div class="text-xs text-blue-100 bg-white/10 p-3 rounded-xl backdrop-blur-sm flex items-center justify-between">
      <span>12개월 환산 월 평균 실수령액</span>
      <span id="monthly-avg-pay" class="font-extrabold text-sm text-white">약 192.5만원</span>
    </div>
  </div>

  <!-- Detailed Table -->
  <div class="border border-slate-200 rounded-2xl p-5 bg-white">
    <h3 class="text-sm font-bold text-slate-800 mb-3 flex items-center justify-between">
      <span>📊 월별 급여 지급 상세 내역</span>
      <span id="policy-applied-tag" class="text-xs text-blue-700 font-semibold">2025 개편 상한액(250만) 적용</span>
    </h3>
    
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-500 border-b border-slate-200">
          <tr>
            <th class="p-2.5">구분</th>
            <th class="p-2.5">지급률 / 상한액</th>
            <th class="p-2.5 text-right">월 지급액</th>
          </tr>
        </thead>
        <tbody id="leave-table-body" class="divide-y divide-slate-100">
          <!-- Populated by JS -->
        </tbody>
      </table>
    </div>
  </div>
</div>

<script is:inline>
  function calculateLeave() {
    const salary = parseInt(document.getElementById('salary-slider').value, 10) * 10000;
    const months = parseInt(document.getElementById('leave-months-select').value, 10);
    const is6Plus6 = document.getElementById('is-6plus6-check').checked;

    document.getElementById('salary-display-badge').innerText = `${Math.floor(salary / 10000)}만원`;

    const sixPlusSixCaps = [2000000, 2500000, 3000000, 3500000, 4000000, 4500000];
    let total = 0;
    let tableRowsHtml = '';

    for (let m = 1; m <= months; m++) {
      let cap = 1600000;
      let rate = 1.0;
      let label = '';

      if (is6Plus6 && m <= 6) {
        cap = sixPlusSixCaps[m - 1];
        label = `6+6제 ${m}개월차 (상한 ${Math.floor(cap / 10000)}만)`;
      } else {
        if (m <= 3) {
          cap = 2500000;
          label = `1~3개월차 (상한 250만)`;
        } else if (m <= 6) {
          cap = 2000000;
          label = `4~6개월차 (상한 200만)`;
        } else {
          cap = 1600000;
          rate = 0.8;
          label = `7~${months}개월차 (상한 160만)`;
        }
      }

      let payout = Math.min(Math.max(salary * rate, 700000), cap);
      total += payout;

      if (m <= 3 || m === 4 || m === 7 || m === months) {
        tableRowsHtml += `
          <tr class="hover:bg-slate-50/50">
            <td class="p-2.5 font-medium text-slate-800">${m}개월차</td>
            <td class="p-2.5 text-slate-500">${label}</td>
            <td class="p-2.5 text-right font-bold text-blue-700">${Math.floor(payout / 10000).toLocaleString()}만원</td>
          </tr>
        `;
      }
    }

    document.getElementById('total-leave-pay').innerText = `${Math.floor(total / 10000).toLocaleString()}만원`;
    document.getElementById('monthly-avg-pay').innerText = `약 ${Math.floor(total / months / 10000).toLocaleString()}만원`;
    document.getElementById('leave-table-body').innerHTML = tableRowsHtml;
  }

  document.getElementById('salary-slider').addEventListener('input', calculateLeave);
  document.getElementById('leave-months-select').addEventListener('change', calculateLeave);
  document.getElementById('is-6plus6-check').addEventListener('change', calculateLeave);

  // Initialize
  calculateLeave();
</script>
