---
import { categories } from '../data/categories';
import { FTC_DISCLOSURE } from '../data/affiliates';
---

<footer class="bg-slate-900 text-slate-400 text-sm border-t border-slate-800 mt-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12">
      
      <!-- Brand & Info -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-teal-500 flex items-center justify-center text-white font-bold text-sm">
            육아
          </div>
          <span class="text-white text-lg font-bold">2025-2026 대한민국 육아정책 모음집</span>
        </div>
        <p class="text-xs sm:text-sm text-slate-400 leading-relaxed max-w-lg">
          본 사이트는 복지로(보건복지부), 고용24(고용노동부), 주택도시기금(국토교통부), 아이사랑포털 등 정부 각 부처의 공식 발표 및 고시 기준을 바탕으로 국민들이 놓치기 쉬운 출산·육아 혜택을 알기 쉽게 정리하여 제공합니다.
        </p>
        <div class="p-3 bg-slate-800/80 rounded-xl text-xs text-slate-400 space-y-1 border border-slate-700/50">
          <div class="font-semibold text-slate-300">📌 면책 조항 및 기준 안내</div>
          <p>
            본 웹사이트의 모든 정보는 참고용으로 제공되며, 정부 법령 및 지자체 조례 개정에 따라 실제 지원 기준이 상이할 수 있습니다. 최종 지원 자격 및 신청은 소관 정부 기관의 공식 안내를 확인하시기 바랍니다.
          </p>
        </div>
        <p class="text-xs text-slate-500">{FTC_DISCLOSURE}</p>
      </div>

      <!-- Category Quick Links -->
      <div>
        <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">주요 지원 분야</h3>
        <ul class="space-y-2 text-xs">
          {categories.map((cat) => (
            <li>
              <a href={`/${cat.slug}`} class="hover:text-teal-400 transition-colors">
                {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Calculators & Official Links -->
      <div>
        <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">모의계산기 & 바로가기</h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/calculators#benefit-calc" class="text-teal-400 hover:underline">
              🧮 육아지원금 통합 계산기
            </a>
          </li>
          <li>
            <a href="/calculators#leave-calc" class="text-teal-400 hover:underline">
              💼 육아휴직 급여 계산기 (250만 상한)
            </a>
          </li>
          <li>
            <a href="/calculators#loan-calc" class="text-teal-400 hover:underline">
              🏠 신생아 특례대출 자격 진단기
            </a>
          </li>
          <li class="pt-2 border-t border-slate-800 text-slate-500">
            <span class="block font-medium text-slate-400 mb-1">공식 정부 포털</span>
            <div class="space-y-1">
              <a href="https://www.bokjiro.go.kr" target="_blank" rel="noopener noreferrer" class="block hover:text-slate-300">➔ 복지로 (보건복지부)</a>
              <a href="https://www.work24.go.kr" target="_blank" rel="noopener noreferrer" class="block hover:text-slate-300">➔ 고용24 (고용노동부)</a>
              <a href="https://nhuf.molit.go.kr" target="_blank" rel="noopener noreferrer" class="block hover:text-slate-300">➔ 주택도시기금 (국토교통부)</a>
            </div>
          </li>
        </ul>
      </div>

    </div>

    <div class="mt-12 pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>&copy; 2025-2026 육아정책모음집. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <a href="/sitemap.xml" class="hover:text-slate-400">사이트맵</a>
        <span>|</span>
        <a href="https://infantpolicy.infoarounds.com" class="hover:text-slate-400">infantpolicy.infoarounds.com</a>
      </div>
    </div>
  </div>
</footer>
