---
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: string;
  canonicalUrl?: string;
  schemaJson?: any[];
}

const {
  title,
  description,
  keywords,
  ogImage,
  canonicalUrl,
  schemaJson
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ko" class="scroll-smooth">
  <head>
    <SeoHead
      title={title}
      description={description}
      keywords={keywords}
      ogImage={ogImage}
      canonicalUrl={canonicalUrl}
      schemaJson={schemaJson}
    />
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased selection:bg-teal-500 selection:text-white min-h-screen flex flex-col">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />

    <!-- AdSense Safe Initializer Fallback -->
    <script is:inline>
      window.addEventListener('load', function() {
        try {
          var ads = document.querySelectorAll('ins.adsbygoogle:not([data-adsbygoogle-status])');
          for (var i = 0; i < ads.length; i++) {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          }
        } catch (e) {}
      });
    </script>
  </body>
</html>
