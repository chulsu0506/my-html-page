---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { policies, type PolicyDetail } from '../../data/policies';
import CoupangPartnersBox from '../../components/CoupangPartnersBox.astro';
import AdSense from '../../components/AdSense.astro';

export function getStaticPaths() {
  return policies.map((policy) => ({
    params: { slug: policy.slug },
    props: { policy }
  }));
}

interface Props {
  policy: PolicyDetail;
}

const { policy } = Astro.props;

// claude-seo: Schema.org FAQPage Schema
const faqSchema = policy.faqs && policy.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": policy.faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
} : null;

// claude-seo: GovernmentService Schema
const govServiceSchema = {
  "@context": "https://schema.org",
  "@type": "GovernmentService",
  "name": policy.title,
  "serviceType": policy.categoryName,
  "provider": {
    "@type": "GovernmentOrganization",
    "name": policy.officialOrg,
    "url": policy.officialUrl
  },
  "description": policy.summary,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "KRW",
    "description": policy.benefitSummary
  }
};

// Breadcrumbs Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "홈",
      "item": "https://infantpolicy.infoarounds.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": policy.categoryName,
      "item": `https://infantpolicy.infoarounds.com/${policy.categorySlug}`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": policy.shortTitle,
      "item": `https://infantpolicy.infoarounds.com/policy/${policy.slug}`
    }
  ]
};

const schemas = [govServiceSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout
  title={`${policy.title} - 2026-2027 자격/금액/신청방법 총정리`}
  description={`${policy.summary} 대상: ${policy.targetAudience} | 혜택: ${policy.benefitSummary} | ${policy.lastVerifiedDate} 공식 발표 자료 기반`}
  keywords={`${policy.title}, ${policy.shortTitle}, ${policy.categoryName}, 2026 ${policy.shortTitle}, 2027 정부지원, 신청방법, 지원금, 자격요건`}
  schemaJson={schemas}
>
  <!-- Policy Header -->
  <div class="bg-gradient-to-b from-teal-500/10 via-slate-50 to-white py-8 sm:py-12 border-b border-slate-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-4" aria-label="현재 위치">
        <a href="/" class="hover:text-teal-600">홈</a>
        <span>&gt;</span>
        <a href={`/${policy.categorySlug}`} class="hover:text-teal-600">{policy.categoryName}</a>
        <span>&gt;</span>
        <span class="text-slate-900 font-semibold">{policy.shortTitle}</span>
      </nav>

      <!-- Category & Badge -->
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-teal-100 text-teal-800">
          {policy.categoryName}
        </span>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800">
          {policy.badge}
        </span>
        <span class="text-xs text-slate-500 bg-white px-2 py-0.5 rounded-md border border-slate-200">
          🕒 {policy.lastVerifiedDate}
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight leading-tight">
        {policy.title}
      </h1>

      <p class="text-sm sm:text-base text-slate-600 mt-3 leading-relaxed">
        {policy.summary}
      </p>

      <!-- E-E-A-T Trust Bar -->
      <div class="mt-6 p-4 rounded-2xl bg-white border border-teal-100 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
        <div class="flex items-center gap-2 text-slate-700">
          <span class="w-2 h-2 rounded-full bg-teal-500"></span>
          <span><strong>소관 부처:</strong> {policy.officialOrg}</span>
        </div>
        <a
          href={policy.officialUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 bg-teal-600 hover:bg-teal-700 text-white font-bold rounded-xl transition-colors"
        >
          <span>🌐</span> 공식 누리집 바로가기 ➔
        </a>
      </div>

    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    
    <!-- Top AdSense -->
    <AdSense slotId={`policy-${policy.slug}-top`} format="auto" />

    <!-- Section 1: Target & Eligibility -->
    <section class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-sm">
      <div class="flex items-center gap-2 mb-4 pb-3 border-b border-slate-100">
        <span class="w-8 h-8 rounded-xl bg-teal-50 text-teal-700 flex items-center justify-center font-bold text-sm">1</span>
        <h2 class="text-xl font-bold text-slate-900">누가 받을 수 있나요? (지원 대상)</h2>
      </div>

      <div class="p-4 bg-teal-50/50 rounded-2xl border border-teal-100 mb-4 text-xs sm:text-sm text-teal-950 font-semibold">
        🎯 <strong>핵심 대상:</strong> {policy.targetAudience}
      </div>

      <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700">
        {policy.eligibility.map((item) => (
          <li class="flex items-start gap-2.5">
            <span class="text-teal-600 font-bold mt-0.5">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Section 2: Benefits & Amount -->
    <section class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-sm">
      <div class="flex items-center gap-2 mb-4 pb-3 border-b border-slate-100">
        <span class="w-8 h-8 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center font-bold text-sm">2</span>
        <h2 class="text-xl font-bold text-slate-900">어떤 혜택을 받나요? (지원 내용 및 금액)</h2>
      </div>

      <div class="p-4 bg-amber-50/60 rounded-2xl border border-amber-200/70 mb-4 text-xs sm:text-sm text-amber-950 font-semibold flex items-center justify-between">
        <span>💰 <strong>주요 지원 혜택:</strong> {policy.benefitSummary}</span>
        <span class="text-xs font-black text-amber-700 bg-white px-2.5 py-1 rounded-lg border border-amber-200">{policy.keyAmount}</span>
      </div>

      <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700">
        {policy.benefits.map((item) => (
          <li class="flex items-start gap-2.5">
            <span class="text-amber-600 font-bold mt-0.5">➔</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Coupang Partners Curation Slot -->
    <CoupangPartnersBox themeKey={policy.affiliateThemeKey || "first-encounter"} />

    <!-- Section 3: How to Apply & Required Docs -->
    <section class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-sm">
      <div class="flex items-center gap-2 mb-4 pb-3 border-b border-slate-100">
        <span class="w-8 h-8 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center font-bold text-sm">3</span>
        <h2 class="text-xl font-bold text-slate-900">어떻게 신청하나요? (신청 방법 및 구비 서류)</h2>
      </div>

      <div class="space-y-4">
        <div>
          <h3 class="text-sm font-bold text-slate-800 mb-2">📋 신청 절차 안내</h3>
          <ol class="space-y-2 text-xs sm:text-sm text-slate-700 list-decimal list-inside bg-slate-50 p-4 rounded-2xl">
            {policy.howToApply.map((step) => (
              <li class="leading-relaxed">{step}</li>
            ))}
          </ol>
        </div>

        {policy.requiredDocuments && policy.requiredDocuments.length > 0 && (
          <div>
            <h3 class="text-sm font-bold text-slate-800 mb-2">📑 구비 서류</h3>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-600">
              {policy.requiredDocuments.map((doc) => (
                <li class="p-2.5 bg-slate-50 rounded-xl border border-slate-100 flex items-center gap-2">
                  <span class="text-blue-500">📎</span>
                  <span>{doc}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <div class="mt-6 pt-4 border-t border-slate-100 text-center">
        <a
          href={policy.officialUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-teal-600 hover:bg-teal-700 text-white font-bold rounded-2xl shadow-lg shadow-teal-600/20 transition-all text-sm"
        >
          <span>🚀</span> {policy.officialOrg} 공식 신청 페이지 이동
        </a>
      </div>
    </section>

    <!-- Section 4: FAQ Accordion (claude-seo Schema) -->
    {policy.faqs && policy.faqs.length > 0 && (
      <section class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-sm">
        <div class="flex items-center gap-2 mb-4 pb-3 border-b border-slate-100">
          <span class="w-8 h-8 rounded-xl bg-purple-50 text-purple-700 flex items-center justify-center font-bold text-sm">?</span>
          <h2 class="text-xl font-bold text-slate-900">자주 묻는 질문 (FAQ)</h2>
        </div>

        <div class="space-y-3">
          {policy.faqs.map((faq) => (
            <details class="group p-4 bg-slate-50 rounded-2xl border border-slate-100 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between cursor-pointer font-bold text-xs sm:text-sm text-slate-800 list-none">
                <span class="flex items-center gap-2">
                  <span class="text-teal-600">Q.</span> {faq.question}
                </span>
                <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <div class="mt-3 pt-3 border-t border-slate-200/60 text-xs sm:text-sm text-slate-600 leading-relaxed">
                <span class="font-bold text-teal-700">A.</span> {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Bottom AdSense -->
    <AdSense slotId="2752528052" format="auto" />

    <!-- Back to Category Link -->
    <div class="text-center pt-4">
      <a
        href={`/${policy.categorySlug}`}
        class="inline-flex items-center gap-2 text-xs font-bold text-teal-700 hover:text-teal-900 bg-teal-50 px-4 py-2 rounded-xl"
      >
        <span>⬅</span> {policy.categoryName} 전체 목록으로 돌아가기
      </a>
    </div>

  </div>
</BaseLayout>
