---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, type Category } from '../data/categories';
import { getPoliciesByCategory, type PolicyDetail } from '../data/policies';
import CoupangPartnersBox from '../components/CoupangPartnersBox.astro';
import AdSense from '../components/AdSense.astro';

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category }
  }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
const categoryPolicies = getPoliciesByCategory(category.slug);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "홈",
      "item": "https://infantpolicy.infoarounds.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": category.name,
      "item": `https://infantpolicy.infoarounds.com/${category.slug}`
    }
  ]
};
---

<BaseLayout
  title={`${category.name} 2026-2027 총정리 - 대한민국 육아정책 모음집`}
  description={`2026-2027 ${category.name} 지원 정책 총정리! ${category.description}`}
  keywords={`${category.name}, 2026 ${category.name}, 2027 육아지원, 정부 지원금, 복지 혜택`}
  schemaJson={[breadcrumbSchema]}
>
  <!-- Category Header -->
  <div class="bg-gradient-to-b from-teal-500/10 via-slate-50 to-white py-10 sm:py-14 border-b border-slate-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-4" aria-label="현재 위치">
        <a href="/" class="hover:text-teal-600">홈</a>
        <span>&gt;</span>
        <span class="text-slate-900 font-semibold">{category.name}</span>
      </nav>

      <div class="space-y-3">
        <span class={`inline-block px-3 py-1 rounded-full text-xs font-bold border ${category.badgeBg}`}>
          {category.tagline}
        </span>
        <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
          {category.name}
        </h1>
        <p class="text-sm sm:text-base text-slate-600 max-w-3xl leading-relaxed">
          {category.description}
        </p>
      </div>

    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Top AdSense -->
    <AdSense slotId={`cat-${category.slug}-top`} format="auto" />

    <div class="mb-8 flex items-center justify-between">
      <h2 class="text-xl font-bold text-slate-900">
        📌 {category.name} 세부 정책 목록 ({categoryPolicies.length}개)
      </h2>
      <a href="/calculators" class="text-xs font-bold text-teal-600 hover:underline">
        지원금 모의계산기 ➔
      </a>
    </div>

    <!-- Policy Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-10">
      {categoryPolicies.map((p) => (
        <a
          href={`/policy/${p.slug}`}
          class="group p-6 bg-white rounded-3xl border border-slate-200/80 hover:border-teal-500 hover:shadow-xl hover:shadow-teal-900/5 transition-all duration-300 flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-teal-50 text-teal-700 border border-teal-200">
                {p.badge}
              </span>
              <span class="text-xs font-black text-teal-700 font-mono">{p.keyAmount}</span>
            </div>

            <h3 class="text-lg font-bold text-slate-900 group-hover:text-teal-600 transition-colors">
              {p.title}
            </h3>
            
            <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed">
              {p.summary}
            </p>

            <div class="mt-4 pt-3 border-t border-slate-100 text-xs text-slate-600 space-y-1">
              <div><strong class="text-slate-800">대상:</strong> {p.targetAudience}</div>
              <div><strong class="text-slate-800">혜택:</strong> {p.benefitSummary}</div>
            </div>
          </div>

          <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="text-slate-400 font-medium">{p.officialOrg}</span>
            <span class="font-bold text-teal-600 group-hover:translate-x-1 transition-transform">
              상세 자격 및 신청법 보기 ➔
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Coupang Partners Box -->
    <CoupangPartnersBox themeKey={categoryPolicies[0]?.affiliateThemeKey || "first-encounter"} />

    <!-- Bottom AdSense -->
    <AdSense slotId="2752528052" format="auto" />

  </div>
</BaseLayout>
