---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../data/categories';
import { policies } from '../data/policies';
import BenefitCalculator from '../components/calculators/BenefitCalculator.astro';
import CoupangPartnersBox from '../components/CoupangPartnersBox.astro';
import AdSense from '../components/AdSense.astro';

const topPolicies = policies.filter(p => ["parent-benefit", "childcare-leave", "childbirth-family-support", "first-encounter-voucher", "child-allowance", "daycare-subsidy"].includes(p.slug));
---

<BaseLayout
  title="2025-2026 임신·출산·육아 정책 정보 및 모의계산기 - 대한민국 육아정책 모음집"
  description="2025-2026 최신 정부 육아정책 총정리! 부모급여(만 0세 월 100만원), 아동수당, 첫만남이용권, 대폭 인상된 육아휴직 급여(월 최대 250만원), 신생아 특례대출 자격 진단기까지 한눈에 확인하세요."
  keywords="2025 육아정책, 2026 육아정책, 부모급여 계산기, 아동수당, 첫만남이용권 바우처, 육아휴직 급여 250만원, 신생아 특례 디딤돌 대출, 출산지원금"
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-teal-500/10 via-emerald-50/40 to-slate-50 pt-10 pb-16 sm:pt-16 sm:pb-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top announcement tag -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-100 text-teal-900 text-xs font-bold mb-4 border border-teal-200">
        <span class="flex h-2 w-2 rounded-full bg-teal-500 animate-pulse"></span>
        2025-2026 대한민국 정부 최신 개정안 100% 반영
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-4 sm:space-y-6">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
            놓치기 쉬운 <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-600 to-emerald-600">출산·육아 지원금</span>,<br class="hidden sm:inline" />
            한곳에서 스마트하게 계산하세요!
          </h1>
          <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
            부모급여 월 100만원, 아동수당, 첫만남이용권부터 월 250만원으로 인상된 육아휴직 급여와 최저 1%대 신생아 특례대출까지, 정부 공식 팩트 기준으로 완벽 정리했습니다.
          </p>

          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a 
              href="#calculator-section"
              class="px-6 py-3.5 bg-teal-600 hover:bg-teal-700 text-white font-bold rounded-2xl shadow-lg shadow-teal-600/25 hover:shadow-xl transition-all duration-200 flex items-center gap-2"
            >
              <span>🧮</span> 지원금 원클릭 계산하기
            </a>
            <a 
              href="/calculators"
              class="px-6 py-3.5 bg-white hover:bg-slate-50 text-slate-800 font-bold rounded-2xl border border-slate-200 shadow-sm transition-all duration-200"
            >
              3대 모의계산기 모음 ➔
            </a>
          </div>
        </div>

        <!-- Hero Quick Stats / Highlights Card -->
        <div class="lg:col-span-5">
          <div class="bg-white rounded-3xl p-6 shadow-xl shadow-teal-900/5 border border-teal-100/80 space-y-4">
            <div class="text-xs font-extrabold text-teal-800 uppercase tracking-wider flex items-center justify-between">
              <span>🔥 2025-2026 핵심 혜택 TOP 3</span>
              <span class="text-[10px] bg-teal-50 text-teal-700 px-2 py-0.5 rounded-md">공식 팩트</span>
            </div>

            <div class="space-y-3">
              <a href="/policy/parent-benefit" class="block p-3.5 rounded-2xl bg-amber-50/60 border border-amber-200/70 hover:border-amber-400 transition-all">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-amber-900">부모급여 (0~1세)</span>
                  <span class="text-xs font-black text-amber-700">월 최대 100만원</span>
                </div>
                <p class="text-[11px] text-slate-500 mt-1">만 0세 월 100만, 만 1세 월 50만 (총 1,800만원)</p>
              </a>

              <a href="/policy/childcare-leave" class="block p-3.5 rounded-2xl bg-blue-50/60 border border-blue-200/70 hover:border-blue-400 transition-all">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-blue-900">육아휴직 급여 대폭 인상</span>
                  <span class="text-xs font-black text-blue-700">월 최대 250만원</span>
                </div>
                <p class="text-[11px] text-slate-500 mt-1">1~3개월 상한 250만, 사후지급금 폐지 (100% 즉시 지급)</p>
              </a>

              <a href="/policy/childbirth-family-support" class="block p-3.5 rounded-2xl bg-cyan-50/60 border border-cyan-200/70 hover:border-cyan-400 transition-all">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-cyan-900">신생아 특례대출 완화</span>
                  <span class="text-xs font-black text-cyan-700">최저 연 1.1%~1.6%</span>
                </div>
                <p class="text-[11px] text-slate-500 mt-1">소득 2억원 완화, 최대 5억원 구입자금 지원</p>
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Top AdSense Slot -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <AdSense slotId="main-top-responsive" format="auto" />
  </div>

  <!-- Interactive Calculator Section -->
  <section id="calculator-section" class="py-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <BenefitCalculator />
    </div>
  </section>

  <!-- Coupang Partners Curation Box -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <CoupangPartnersBox themeKey="first-encounter" />
  </section>

  <!-- 7 Major Categories Section -->
  <section class="py-12 bg-white border-y border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900">
          7대 분야별 정부 지원 정책 살펴보기
        </h2>
        <p class="text-sm text-slate-500 mt-2">
          임신 준비부터 출산, 영유아 양육, 일·가정 양립, 주거 지원까지 필요한 모든 제도를 안내합니다.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {categories.map((cat) => (
          <a
            href={`/${cat.slug}`}
            class="group relative rounded-3xl p-6 bg-slate-50 border border-slate-200/80 hover:border-teal-500/50 hover:bg-teal-50/30 hover:shadow-xl hover:shadow-teal-900/5 transition-all duration-300 flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class={`px-3 py-1 rounded-full text-xs font-bold border ${cat.badgeBg}`}>
                  {cat.tagline}
                </span>
                <span class="text-slate-400 group-hover:text-teal-600 group-hover:translate-x-1 transition-all">➔</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-teal-700 transition-colors">
                {cat.name}
              </h3>
              <p class="text-xs text-slate-500 mt-2 leading-relaxed line-clamp-3">
                {cat.description}
              </p>
            </div>

            <div class="mt-6 pt-3 border-t border-slate-200/60 flex items-center justify-between text-xs font-bold text-teal-700">
              <span>상세 정책 리스트 보기</span>
              <span>확인 ➔</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- Popular Policies Grid -->
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-8">
        <div>
          <span class="text-xs font-bold text-teal-700 uppercase tracking-wider">주요 핵심 정책</span>
          <h2 class="text-2xl font-black text-slate-900 mt-1">부모들이 가장 많이 찾는 정책 BEST 6</h2>
        </div>
        <a href="/calculators" class="text-xs font-bold text-teal-600 hover:underline">모든 계산기 모아보기 ➔</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {topPolicies.map((p) => (
          <a
            href={`/policy/${p.slug}`}
            class="group p-5 bg-white rounded-2xl border border-slate-200 hover:border-teal-400 hover:shadow-lg transition-all duration-200 flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-[11px] font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded">
                  {p.categoryName}
                </span>
                <span class="text-xs font-black text-teal-700">{p.keyAmount}</span>
              </div>
              <h3 class="text-base font-bold text-slate-900 group-hover:text-teal-600 transition-colors line-clamp-1">
                {p.title}
              </h3>
              <p class="text-xs text-slate-500 mt-1.5 line-clamp-2 leading-relaxed">
                {p.summary}
              </p>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-400">{p.officialOrg}</span>
              <span class="font-bold text-teal-600 group-hover:translate-x-0.5 transition-transform">자세히 보기 ➔</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom AdSense Slot -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-10">
    <AdSense slotId="main-bottom-responsive" format="auto" />
  </div>
</BaseLayout>
